# 10.0.2.2 is the host as seen from QEMU's default user network.
# Run a plain HTTP server on the host's port 8000 before running this script.
let socket = tcp_connect("10.0.2.2", 8000);
if (socket < 0) { print("connect failed"); } else {
    let request = "GET / HTTP/1.0\r\nHost: localhost\r\nConnection: close\r\n\r\n";
    let sent = tcp_send(socket, request, len(request));
    let output = open("/HTTP.TXT", O_WRONLY + O_CREAT + O_TRUNC);
    let buffer = malloc(512);
    let n = tcp_recv(socket, buffer, len(buffer));
    let total = 0;
    while (n > 0) {
        let written = write(output, buffer, n);
        if (written != n) { print("write failed"); }
        total = total + n;
        n = tcp_recv(socket, buffer, len(buffer));
    }
    if (n < 0) { print("receive failed"); }
    print("received=", total);
    close(output);
    free(buffer);
    tcp_close(socket);
}
